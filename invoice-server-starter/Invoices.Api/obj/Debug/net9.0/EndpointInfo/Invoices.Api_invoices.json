  "components": {
    "schemas": {
      "Country": {
        "enum": [
          "CZECHIA",
          "SLOVAKIA"
        ],
        "type": "string"
      },
      "InvoiceDto": {
        "required": [
          "buyerId",
          "dueDate",
          "invoiceNumber",
          "issued",
          "price",
          "product",
          "sellerId",
          "vat"
        ],
        "type": "object",
        "properties": {
          "_id": {
            "type": "integer",
            "format": "int64"
          },
          "invoiceNumber": {
            "type": "integer",
            "format": "int32"
          },
          "issued": {
            "type": "string",
            "format": "date-time"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          },
          "product": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "price": {
            "maximum": 999999999,
            "minimum": 1,
            "type": "number",
            "format": "double"
          },
          "vat": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "note": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "buyerId": {
            "type": "integer",
            "format": "int64"
          },
          "sellerId": {
            "type": "integer",
            "format": "int64"
          },
          "buyer": {
            "$ref": "#/components/schemas/PersonDto"
          },
          "seller": {
            "$ref": "#/components/schemas/PersonDto"
          }
        },
        "additionalProperties": false
      },
      "InvoiceStatisticsDto": {
        "type": "object",
        "properties": {
          "currentYearSum": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "allTimeSum": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "invoicesCount": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PersonDto": {
        "required": [
          "accountNumber",
          "bankCode",
          "city",
          "country",
          "iban",
          "identificationNumber",
          "mail",
          "name",
          "street",
          "zip"
        ],
        "type": "object",
        "properties": {
          "_id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "identificationNumber": {
            "minLength": 1,
            "pattern": "^\\d{8}$",
            "type": "string"
          },
          "taxNumber": {
            "pattern": "^[A-Z]{2}\\d{8,10}$",
            "type": "string",
            "nullable": true
          },
          "accountNumber": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "bankCode": {
            "minLength": 1,
            "pattern": "^\\d{4}$",
            "type": "string"
          },
          "iban": {
            "maxLength": 34,
            "minLength": 0,
            "type": "string"
          },
          "telephone": {
            "type": "string",
            "format": "tel",
            "nullable": true
          },
          "mail": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "street": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "zip": {
            "minLength": 1,
            "pattern": "^\\d{5}$",
            "type": "string"
          },
          "city": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "$ref": "#/components/schemas/Country"
          }
        },
        "additionalProperties": false
      },
      "PersonStatisticsDto": {
        "type": "object",
        "properties": {
          "personId": {
            "type": "integer",
            "format": "int32"
          },
          "personName": {
            "type": "string",
            "nullable": true
          },
          "revenue": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    }
  }
}